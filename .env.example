# Optional cloud management-guidance providers.
# Copy only the variables you need into your shell or an ignored local env file.
# Never expose these keys through Vite variables or commit real values.
# The local React demo can also set a temporary process-memory override through
# Management guidance -> Configure. It is cleared when FastAPI restarts.
# Prefer environment variables or a secret manager for deployed servers.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
