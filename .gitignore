.DS_Store
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local data, caches, and generated artifacts
/data/
/datasets/
/.cache/
/outputs
*.pt
*.pth
*.ckpt
*.onnx

# Notebook and editor state
.ipynb_checkpoints/
.idea/
.vscode/

# React frontend dependencies and production output
/frontend/node_modules/
/frontend/dist/

# Isolated agent worktrees
/.worktrees/

# LaTeX build side files
paper/out/*.aux
paper/out/*.bbl
paper/out/*.blg
paper/out/*.log
paper/out/*.out
paper/out/missfont.log

# Local-only research and presentation working files
# Published source artifacts that are already tracked remain tracked; these rules
# prevent new private deck revisions and editable working files from being added.
/docs/presentation/*.key
/docs/presentation/*.pptx
/docs/presentation/*.pptx.inspect.ndjson
/docs/presentation/*_deck/
/private/
